{
    "name": "pluginverse/pv-wpms-sso",
    "description": "Plugin Verse WordPress Multisite Single Sign On — one identity site, one login, signed single-use tickets into every site of a domain-mapped multisite or same-database multi-network install.",
    "type": "wordpress-plugin",
    "license": "GPL-3.0-or-later",
    "keywords": [
        "wordpress",
        "wordpress-plugin",
        "multisite",
        "sso",
        "single-sign-on",
        "saml"
    ],
    "homepage": "https://github.com/pluginverse/pv-wpms-sso-plugin",
    "authors": [
        {
            "name": "Plugin Verse",
            "homepage": "https://github.com/pluginverse"
        }
    ],
    "require": {
        "php": ">=8.2",
        "onelogin/php-saml": "^4.0"
    },
    "require-dev": {
        "behat/behat": "^4.0",
        "php-stubs/wp-cli-stubs": "^2.12",
        "phpstan/extension-installer": "^1.0",
        "phpstan/phpstan": "^2.0",
        "phpstan/phpstan-phpunit": "^2.0",
        "phpunit/phpunit": "^9.0",
        "szepeviktor/phpstan-wordpress": "^2.0",
        "wp-phpunit/wp-phpunit": "^6.7",
        "yoast/phpunit-polyfills": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "PV\\WpmsSso\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "PV\\WpmsSso\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "env:start": "npx @wordpress/env start",
        "env:debug": "npx @wordpress/env start --xdebug=profile,trace,debug",
        "env:stop": "npx @wordpress/env stop",
        "test": "sh bin/test.sh",
        "test-unit": "phpunit --testsuite unit",
        "phpstan": "phpstan analyse --memory-limit=1G",
        "test-bdd": "sh bin/behavior.sh",
        "test-trace": "python3 bin/trace_ids.py --features tests/Behavior/features --tests tests --strict",
        "test-scripts": "python3 -m unittest discover -s scripts/tests",
        "package": "python3 scripts/package.py"
    },
    "config": {
        "platform": {
            "php": "8.2"
        },
        "sort-packages": true,
        "allow-plugins": {
            "phpstan/extension-installer": true
        }
    }
}
